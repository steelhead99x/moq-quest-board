  "description": "An 8-bit board, dependency map, and inbox for Quest trees (moq-dev/quest) across your repositories",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steelhead99x/quest-board.git"
  },
  "homepage": "https://github.com/steelhead99x/quest-board#readme",
  "bugs": {
    "url": "https://github.com/steelhead99x/quest-board/issues"
  },
  "bin": {
    "quest-board": "server.mjs"
  },
  "main": "server.mjs",
  "files": [
